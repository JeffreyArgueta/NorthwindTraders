# =============================================================================
# Stage 1 – build the Vite / Vue 3 app
# Place this file at: frontend/Dockerfile
# Build context is the frontend/ folder (set in docker-compose.yml)
# =============================================================================
FROM node:24-alpine AS build
WORKDIR /app

# Pass build-time args so Vite embeds them into the client bundle
ARG VITE_API_BASE_URL=http://localhost:5000
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

ARG VITE_GOOGLE_MAPS_API_KEY
ENV VITE_GOOGLE_MAPS_API_KEY=${VITE_GOOGLE_MAPS_API_KEY}

# Install dependencies (cache-friendly layer)
COPY package*.json ./
RUN npm ci

# Copy source and build
COPY . .
RUN npm run build

# =============================================================================
# Stage 2 – serve with Nginx (tiny runtime image)
# =============================================================================
FROM nginx:1.29-alpine AS runtime

# Remove default Nginx page and copy built assets
RUN rm -rf /usr/share/nginx/html/*
COPY --from=build /app/dist /usr/share/nginx/html

# Nginx config that supports Vue Router history mode
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
